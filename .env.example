# 서울 열린데이터광장 실시간 지하철 인증키 (https://data.seoul.go.kr)
# 비워두면 시뮬레이션(mock) 데이터로 동작합니다.
SEOUL_API_KEY=

# 실제 API 폴링 주기 (ms). 한 번 호출(realtimeStationArrival/ALL)로 전 노선을 받습니다.
# 일일 한도 1,000회 기준: 운행시간(05:30~01:00, 19.5h)만 폴링하므로 75초 → 하루 약 936회.
# 서버를 자주 재시작하면 호출이 더 쓰이니 여유를 두세요.
POLL_MS=75000

# mock 모드 시간 배속
MOCK_SPEED=8

PORT=3000
